---
// src/components/shared/Header.astro
const navLinks = [
  { name: "Inicio", href: "#" },
  { name: "Destacado", href: "#showcase" },
  { name: "Catálogo", href: "#catalogo" },
  { name: "Kits DIY", href: "#diy" },
  { name: "Proceso", href: "#proceso" },
];
---

<header
  id="main-header"
  class="fixed top-0 w-full z-50 transition-transform duration-500 bg-[#050505]/80 backdrop-blur-xl border-b border-white/5 shadow-2xl"
>
  <div
    class="max-w-7xl mx-auto px-6 h-20 flex items-center justify-between relative"
  >
    <!-- NUEVO LOGO: Levos 3D (Diseño Papel) -->
    <a href="#" class="nav-link flex items-center gap-3 group z-50">
      <!-- Icono Origami Papel 3D -->
      <div
        class="w-9 h-9 bg-gradient-to-br from-emerald-400 to-emerald-600 rounded-xl flex items-center justify-center transform group-hover:rotate-[15deg] group-hover:scale-110 transition-all duration-300 shadow-[0_0_20px_rgba(16,185,129,0.4)] border border-emerald-300/30"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="#050505"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <!-- Figura geométrica estilo pliegue de papel / módulo 3D -->
          <polygon points="12 2 22 8.5 12 15 2 8.5 12 2"></polygon>
          <polygon points="12 22 22 15 12 15 2 15 12 22"></polygon>
          <polyline points="2 15 12 8.5 22 15"></polyline>
        </svg>
      </div>

      <!-- Texto Levos 3D (con 3D arriba de la s) -->
      <span class="font-serif text-2xl text-white tracking-wide">
        Levo<span class="relative inline-block">
          <span
            class="absolute -top-3.5 left-1/2 -translate-x-1/2 text-[9px] font-sans font-black text-emerald-400 tracking-wider drop-shadow-[0_0_10px_rgba(16,185,129,0.9)] uppercase"
          >
            3D
          </span>
          s
        </span>
      </span>
    </a>

    <!-- Desktop Nav -->
    <nav class="hidden lg:flex items-center gap-8">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class="nav-link text-sm font-medium text-zinc-400 hover:text-white transition-colors relative group"
          >
            {link.name}
            <span class="absolute -bottom-2 left-0 w-0 h-0.5 bg-emerald-500 transition-all duration-300 group-hover:w-full" />
          </a>
        ))
      }
    </nav>

    <!-- Actions (Carrito + Menu Móvil) -->
    <div class="flex items-center gap-4 z-50">
      <!-- Botón Carrito -->
      <button
        id="cart-toggle-btn"
        class="relative w-10 h-10 rounded-full bg-zinc-900/80 border border-zinc-800 flex items-center justify-center text-zinc-300 hover:text-white hover:bg-zinc-800 transition-all hover:border-emerald-500/50 group"
        aria-label="Abrir Carrito"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="group-hover:scale-110 transition-transform"
          ><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"
          ></circle><path
            d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"
          ></path></svg
        >

        <!-- Contador Reactivo -->
        <span
          id="cart-counter"
          class="absolute -top-1 -right-1 bg-emerald-500 text-black text-[10px] font-bold w-4.5 h-4.5 flex items-center justify-center rounded-full shadow-[0_0_10px_rgba(16,185,129,0.5)] transform scale-0 transition-transform duration-300 pointer-events-none"
        >
          0
        </span>
      </button>

      <!-- Toggle Menú Móvil -->
      <button
        id="mobile-menu-btn"
        class="lg:hidden w-10 h-10 rounded-full bg-zinc-900/80 border border-zinc-800 flex flex-col items-center justify-center gap-1.5 text-white"
        aria-label="Abrir Menú"
      >
        <span
          class="w-4 h-[2px] bg-current transform transition-all duration-300 origin-center"
        ></span>
        <span
          class="w-4 h-[2px] bg-current transform transition-all duration-300 origin-center"
        ></span>
      </button>
    </div>
  </div>

  <!-- Menú Móvil Overlay -->
  <div
    id="mobile-menu"
    class="fixed inset-0 bg-[#050505]/95 backdrop-blur-xl z-40 lg:hidden flex flex-col items-center justify-center gap-8 transform -translate-y-full transition-transform duration-500 ease-[cubic-bezier(0.4,0,0.2,1)] pt-20"
  >
    {
      navLinks.map((link) => (
        <a
          href={link.href}
          class="nav-link text-2xl font-serif text-zinc-400 hover:text-white transition-colors"
        >
          {link.name}
        </a>
      ))
    }
  </div>
</header>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    // --- 1. LÓGICA DEL CARRITO (REACTIVIDAD) ---
    const cartCounter = document.getElementById("cart-counter");
    const cartToggleBtn = document.getElementById("cart-toggle-btn");

    // Escucha al Store Central para actualizar el Badge
    document.addEventListener("cart:updated", (e: Event) => {
      const customEvent = e as CustomEvent;
      const count = customEvent.detail.count;
      if (cartCounter) {
        if (count > 0) {
          cartCounter.textContent = count.toString();
          cartCounter.classList.remove("scale-0");
          cartCounter.classList.add("scale-100");
        } else {
          cartCounter.classList.add("scale-0");
          cartCounter.classList.remove("scale-100");
        }
      }
    });

    // Abre el Panel del Carrito
    cartToggleBtn?.addEventListener("click", () => {
      document.dispatchEvent(new CustomEvent("cart:toggle"));
    });

    // Hidratación Inicial: Por si el script carga después del HTML, leemos directo
    try {
      const initialCart = JSON.parse(
        localStorage.getItem("origami_cart") || "[]",
      );
      const initialCount = initialCart.reduce(
        (acc: number, item: any) => acc + item.quantity,
        0,
      );
      if (initialCount > 0 && cartCounter) {
        cartCounter.textContent = initialCount.toString();
        cartCounter.classList.remove("scale-0");
        cartCounter.classList.add("scale-100");
      }
    } catch (err) {
      console.warn("Error leyendo carrito inicial", err);
    }

    // --- 2. HEADER SCROLL & MOBILE MENU ---
    const header = document.getElementById("main-header");
    const mobileMenuBtn = document.getElementById("mobile-menu-btn");
    const mobileMenu = document.getElementById("mobile-menu");
    const lines = mobileMenuBtn?.querySelectorAll("span");
    let lastScroll = window.scrollY;
    let menuOpen = false;

    window.addEventListener(
      "scroll",
      () => {
        const currentScroll = window.scrollY;
        // Solo ocultar/mostrar si el menú móvil está cerrado
        if (!menuOpen && header) {
          if (currentScroll > 100 && currentScroll > lastScroll) {
            header.style.transform = "translateY(-100%)";
          } else {
            header.style.transform = "translateY(0)";
          }

          // Fondo un poco más sólido al scrollear
          if (currentScroll > 50) {
            header.classList.add("bg-[#050505]/95");
            header.classList.remove("bg-[#050505]/80");
          } else {
            header.classList.add("bg-[#050505]/80");
            header.classList.remove("bg-[#050505]/95");
          }
        }
        lastScroll = currentScroll;
      },
      { passive: true },
    );

    function toggleMenu() {
      menuOpen = !menuOpen;
      if (menuOpen) {
        mobileMenu?.classList.remove("-translate-y-full");
        mobileMenu?.classList.add("translate-y-0");
        if (lines) {
          lines[0].style.transform = "translateY(4px) rotate(45deg)";
          lines[1].style.transform = "translateY(-4px) rotate(-45deg)";
        }
        document.body.style.overflow = "hidden";
        if (header) header.style.transform = "translateY(0)";
      } else {
        mobileMenu?.classList.add("-translate-y-full");
        mobileMenu?.classList.remove("translate-y-0");
        if (lines) {
          lines[0].style.transform = "none";
          lines[1].style.transform = "none";
        }
        document.body.style.overflow = "";
      }
    }
    mobileMenuBtn?.addEventListener("click", toggleMenu);

    // --- 3. NAVEGACIÓN PERFECTA ---
    const navLinks = document.querySelectorAll(".nav-link");

    function navigateToSection(targetId: string) {
      if (targetId === "#") {
        window.scrollTo({ top: 0, behavior: "smooth" });
        return;
      }

      const targetElement = document.querySelector(targetId) as HTMLElement;
      if (!targetElement) return;

      const headerHeight = header ? header.getBoundingClientRect().height : 80;
      const absoluteTop =
        window.scrollY + targetElement.getBoundingClientRect().top;
      let targetScrollPosition = absoluteTop - headerHeight;

      // ESTRATEGIA INTELIGENTE POR SECCIÓN (Ignorando paddings masivos)
      if (targetId === "#showcase") {
        // Buscamos el contenedor interno (div) para saltar el padding py-32
        const innerContent = targetElement.querySelector("div");
        if (innerContent) {
          targetScrollPosition =
            window.scrollY +
            innerContent.getBoundingClientRect().top -
            headerHeight -
            40;
        }
      } else if (
        targetId === "#catalogo" ||
        targetId === "#diy" ||
        targetId === "#proceso"
      ) {
        // Alineamos directamente con el título h2 de la sección
        const titleElement = targetElement.querySelector("h2");
        if (titleElement) {
          targetScrollPosition =
            window.scrollY +
            titleElement.getBoundingClientRect().top -
            headerHeight -
            30;
        }
      }

      // Forzar header visible post-click
      if (header) header.style.transform = "translateY(0)";

      window.scrollTo({
        top: targetScrollPosition,
        behavior: "smooth",
      });

      history.pushState(null, "", targetId);
    }

    navLinks.forEach((link) => {
      link.addEventListener("click", (e) => {
        const href = link.getAttribute("href");
        if (href && href.startsWith("#")) {
          e.preventDefault();
          if (menuOpen) toggleMenu();
          navigateToSection(href);
        }
      });
    });
  });
</script>
