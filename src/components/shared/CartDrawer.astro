---
// src/components/shared/CartDrawer.astro
// Carrito Oficial con Almacenamiento Local y Cierre Exclusivo por WhatsApp
const whatsappNumber = import.meta.env.PUBLIC_WHATSAPP_NUMBER || "573001234567";
// Normalizamos el número a solo dígitos para evitar URLs rotas
const cleanWhatsappNumber = whatsappNumber.replace(/\D/g, "");
---

<div id="cart-drawer-backdrop" class="fixed inset-0 bg-black/70 backdrop-blur-sm z-[200] hidden opacity-0 transition-opacity duration-300 cursor-pointer"></div>

<div id="cart-drawer" data-whatsapp={cleanWhatsappNumber} class="fixed top-0 right-0 h-full w-full sm:w-[450px] bg-[#0a0a0a] border-l border-zinc-800/60 z-[210] transform translate-x-full transition-transform duration-500 ease-[cubic-bezier(0.4,0,0.2,1)] flex flex-col shadow-[0_0_50px_rgba(0,0,0,0.8)]">
    
    <!-- Header Drawer -->
    <div class="p-6 sm:p-8 border-b border-zinc-800/80 flex justify-between items-center bg-[#0a0a0a] z-10">
        <h2 class="text-xl sm:text-2xl font-serif text-white flex items-center gap-3">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-emerald-500"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>
            Tu Carrito
        </h2>
        <button id="close-cart-btn" class="w-10 h-10 rounded-full bg-zinc-900 border border-zinc-800 text-zinc-400 hover:text-white hover:bg-zinc-800 flex justify-center items-center transition-all group" aria-label="Cerrar Carrito">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="group-hover:rotate-90 transition-transform duration-300"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
        </button>
    </div>
    
    <!-- Contenedor de Figuras -->
    <div id="cart-items-container" class="flex-1 overflow-y-auto p-6 sm:p-8 space-y-4 no-scrollbar relative bg-[#0a0a0a]">
        
        <!-- Estado Vacío -->
        <div id="cart-empty-state" class="absolute inset-0 flex flex-col items-center justify-center text-center px-6 opacity-0 hidden transition-opacity duration-300">
            <div class="w-20 h-20 bg-zinc-900/50 rounded-full flex items-center justify-center mb-6 border border-zinc-800 shadow-inner">
                <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-zinc-500"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path><line x1="3" y1="3" x2="21" y2="21" class="text-emerald-500"></line></svg>
            </div>
            <h3 class="text-xl font-serif text-white mb-2">Tu carrito está vacío</h3>
            <p class="text-zinc-500 text-sm mb-8 leading-relaxed max-w-[250px]">Aún no has seleccionado ninguna figura para tu colección.</p>
            <button id="cart-continue-shopping" class="px-6 py-3 bg-white text-black rounded-full text-sm font-semibold hover:bg-zinc-200 transition-all shadow-[0_0_15px_rgba(255,255,255,0.1)]">Explorar Catálogo</button>
        </div>
        
    </div>

    <!-- Footer Checkout vía WhatsApp (Sin Pasarelas de Pago) -->
    <div id="cart-footer" class="p-6 sm:p-8 border-t border-zinc-800/80 bg-[#0a0a0a] z-10 hidden flex-col">
        <div class="flex justify-between items-end mb-6">
            <span class="text-zinc-400 font-medium text-sm tracking-wide">Total Estimado</span>
            <span id="cart-total-price" class="text-3xl font-serif text-white">$0</span>
        </div>
        <button id="cart-checkout-whatsapp" class="w-full bg-emerald-500 hover:bg-emerald-400 text-black font-semibold py-4 rounded-xl transition-all shadow-[0_0_20px_rgba(16,185,129,0.3)] hover:shadow-[0_0_30px_rgba(16,185,129,0.5)] hover:-translate-y-1 flex items-center justify-center gap-3 text-sm sm:text-base">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
            </svg>
            Finalizar Pedido por WhatsApp
        </button>
    </div>
</div>

<script>
    class CartStoreManager {
        items: Array<{
            id: string | number;
            name: string;
            variant: string;
            price: number;
            img: string;
            quantity: number;
        }>;
        whatsappPhone: string;

        constructor() {
            this.items = [];
            const drawerEl = document.getElementById('cart-drawer');
            this.whatsappPhone = drawerEl?.getAttribute('data-whatsapp') || "573001234567";
            this.initStore();
            this.initListeners();
            this.render();
        }

        initStore() {
            try {
                this.items = JSON.parse(localStorage.getItem('origami_cart') || '[]');
            } catch(e) {
                this.items = [];
            }
        }

        initListeners() {
            document.addEventListener('cart:add', (e: Event) => {
                const customEvent = e as CustomEvent;
                this.addItem(customEvent.detail);
                this.openDrawer();
            });

            document.addEventListener('cart:toggle', () => this.toggleDrawer());
            
            document.getElementById('close-cart-btn')?.addEventListener('click', () => this.closeDrawer());
            document.getElementById('cart-drawer-backdrop')?.addEventListener('click', () => this.closeDrawer());
            document.getElementById('cart-continue-shopping')?.addEventListener('click', () => {
                this.closeDrawer();
                const btn = document.querySelector('.nav-link[href="#catalogo"]') as HTMLElement;
                if(btn) btn.click();
            });

            // Disparador del Pedido vía WhatsApp
            document.getElementById('cart-checkout-whatsapp')?.addEventListener('click', () => this.checkoutWhatsApp());
        }

        addItem(product: { id: string | number; name: string; variant: string; price: number; img: string }) {
            const existing = this.items.find(i => i.id === product.id && i.variant === product.variant);
            if (existing) {
                existing.quantity += 1;
            } else {
                this.items.push({
                    id: product.id,
                    name: product.name,
                    variant: product.variant,
                    price: Number(product.price) || 0,
                    img: product.img,
                    quantity: 1
                });
            }
            this.saveAndBroadcast();
        }

        updateQuantity(index: number, delta: number) {
            if (!this.items[index]) return;
            this.items[index].quantity += delta;
            if (this.items[index].quantity <= 0) {
                this.items.splice(index, 1);
            }
            this.saveAndBroadcast();
        }

        saveAndBroadcast() {
            localStorage.setItem('origami_cart', JSON.stringify(this.items));
            this.render();
            const totalCount = this.items.reduce((acc, item) => acc + item.quantity, 0);
            document.dispatchEvent(new CustomEvent('cart:updated', { detail: { count: totalCount } }));
        }

        render() {
            const container = document.getElementById('cart-items-container');
            const emptyState = document.getElementById('cart-empty-state');
            const totalEl = document.getElementById('cart-total-price');
            const footer = document.getElementById('cart-footer');

            if (!container || !emptyState || !totalEl || !footer) return;

            Array.from(container.children).forEach(child => {
                if (child.id !== 'cart-empty-state') child.remove();
            });

            if (this.items.length === 0) {
                emptyState.classList.remove('hidden');
                emptyState.classList.add('flex');
                setTimeout(() => emptyState.style.opacity = '1', 50);
                footer.classList.add('hidden');
                footer.classList.remove('flex');
                return;
            }

            emptyState.classList.add('hidden');
            emptyState.classList.remove('flex');
            emptyState.style.opacity = '0';
            
            footer.classList.remove('hidden');
            footer.classList.add('flex');

            let total = 0;

            this.items.forEach((item, index) => {
                const subtotal = item.price * item.quantity;
                total += subtotal;
                
                const itemEl = document.createElement('div');
                itemEl.className = 'flex gap-4 bg-[#121212] p-3 rounded-[1.25rem] border border-zinc-800/80 shadow-md transition-all hover:border-zinc-700';
                itemEl.innerHTML = `
                    <div class="w-[84px] h-[84px] bg-zinc-900 rounded-xl overflow-hidden flex-shrink-0 relative border border-zinc-800">
                        <img src="${item.img}" class="w-full h-full object-cover" alt="${item.name}" loading="lazy">
                    </div>
                    <div class="flex-1 flex flex-col justify-between py-1 pr-1">
                        <div>
                            <div class="flex justify-between items-start">
                                <h4 class="text-sm sm:text-base font-serif text-white leading-tight line-clamp-1">${item.name}</h4>
                            </div>
                            <span class="text-[10px] text-emerald-400 bg-emerald-500/10 px-2 py-0.5 rounded border border-emerald-500/20 uppercase tracking-wider mt-1.5 inline-block font-medium">${item.variant}</span>
                        </div>
                        <div class="flex justify-between items-center mt-2">
                            <span class="text-sm font-medium text-white tracking-wide">$${item.price.toLocaleString('es-CO')}</span>
                            <div class="flex items-center gap-2 bg-[#0a0a0a] px-2 py-1 rounded-lg border border-zinc-800 shadow-inner">
                                <button class="w-6 h-6 flex items-center justify-center text-zinc-400 hover:text-white hover:bg-zinc-800 rounded transition-colors btn-qty" data-action="dec" data-index="${index}">-</button>
                                <span class="text-xs text-white w-4 text-center font-medium">${item.quantity}</span>
                                <button class="w-6 h-6 flex items-center justify-center text-zinc-400 hover:text-white hover:bg-zinc-800 rounded transition-colors btn-qty" data-action="inc" data-index="${index}">+</button>
                            </div>
                        </div>
                    </div>
                `;
                container.appendChild(itemEl);
            });

            totalEl.textContent = '$' + total.toLocaleString('es-CO');

            container.querySelectorAll('.btn-qty').forEach(btn => {
                btn.addEventListener('click', (e) => {
                    const target = e.currentTarget as HTMLElement;
                    const action = target.dataset.action;
                    const idx = parseInt(target.dataset.index || '0');
                    if (action === 'inc') this.updateQuantity(idx, 1);
                    if (action === 'dec') this.updateQuantity(idx, -1);
                });
            });
        }

        checkoutWhatsApp() {
            if (this.items.length === 0) return;

            let total = 0;
            let message = "👋 ¡Hola Levos 3D! Me gustaría realizar el siguiente pedido de Origami 3D:\n\n";

            this.items.forEach((item, index) => {
                const subtotal = item.price * item.quantity;
                total += subtotal;
                message += `${index + 1}. *${item.name}*\n`;
                message += `   • Formato: ${item.variant}\n`;
                message += `   • Cantidad: ${item.quantity}\n`;
                message += `   • Precio Unitario: $${item.price.toLocaleString('es-CO')}\n`;
                message += `   • Subtotal: $${subtotal.toLocaleString('es-CO')}\n\n`;
            });

            message += `───────────────────\n`;
            message += `💰 *TOTAL ESTIMADO: $${total.toLocaleString('es-CO')}*\n`;
            message += `───────────────────\n\n`;
            message += `¿Me confirman disponibilidad y los datos para coordinar el envío? ¡Muchas gracias!`;

            const encodedMessage = encodeURIComponent(message);
            const whatsappUrl = `https://wa.me/${this.whatsappPhone}?text=${encodedMessage}`;
            window.open(whatsappUrl, '_blank', 'noopener,noreferrer');
        }

        openDrawer() {
            const drawer = document.getElementById('cart-drawer');
            const backdrop = document.getElementById('cart-drawer-backdrop');
            if (drawer && backdrop) {
                drawer.classList.remove('translate-x-full');
                backdrop.classList.remove('hidden');
                setTimeout(() => backdrop.style.opacity = '1', 10);
                document.body.style.overflow = 'hidden';
            }
        }

        closeDrawer() {
            const drawer = document.getElementById('cart-drawer');
            const backdrop = document.getElementById('cart-drawer-backdrop');
            if (drawer && backdrop) {
                drawer.classList.add('translate-x-full');
                backdrop.style.opacity = '0';
                setTimeout(() => backdrop.classList.add('hidden'), 300);
                document.body.style.overflow = '';
            }
        }

        toggleDrawer() {
            const drawer = document.getElementById('cart-drawer');
            if (drawer?.classList.contains('translate-x-full')) {
                this.openDrawer();
            } else {
                this.closeDrawer();
            }
        }
    }

    document.addEventListener('DOMContentLoaded', () => {
        (window as any).cartStoreManager = new CartStoreManager();
    });
</script>