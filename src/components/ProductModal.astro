---
// src/components/ProductModal.astro
// Modal responsive: Composición adaptada para Mobile, Tablet y Desktop
---

<div id="product-modal-backdrop" class="fixed inset-0 z-[100] hidden bg-black/75 backdrop-blur-md items-end sm:items-center justify-center p-0 sm:p-6 opacity-0" aria-modal="true" role="dialog">
  
  <!-- Contenedor Principal del Modal: Sheet en Mobile, Modal Flotante en Tablet/Desktop -->
  <div id="product-modal-content" class="bg-[#09090b] border border-white/10 rounded-t-[2.25rem] sm:rounded-[2.5rem] w-full max-w-5xl flex flex-col lg:flex-row overflow-hidden transform opacity-0 shadow-[0_25px_60px_-15px_rgba(0,0,0,0.9)] relative h-[92dvh] sm:h-[88vh] lg:h-[84vh] max-h-[860px]">
    
    <!-- Botón Cerrar Flotante (Touch Target Cómodo) -->
    <button id="modal-close" class="absolute top-4 right-4 sm:top-6 sm:right-6 z-50 w-11 h-11 flex items-center justify-center bg-black/60 backdrop-blur-xl border border-white/15 text-zinc-300 rounded-full hover:bg-white hover:text-black transition-all duration-300 shadow-xl group active:scale-95" aria-label="Cerrar modal">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="group-hover:rotate-90 transition-transform duration-300"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
    </button>

    <!-- COLUMNA 1: GALERÍA DE IMÁGENES (Mobile-optimized con object-contain) -->
    <div class="w-full h-[40%] xs:h-[44%] sm:h-[48%] lg:w-[46%] lg:h-full relative flex flex-col flex-shrink-0 bg-[#060608] border-b lg:border-b-0 lg:border-r border-white/10 overflow-hidden group">
      
      <!-- Contenedor de la Imagen Principal -->
      <div class="relative w-full h-full flex-1 overflow-hidden flex items-center justify-center p-3 sm:p-5 lg:p-8">
        <!-- Glow dinámico de fondo -->
        <div id="modal-img-glow" class="absolute inset-0 bg-emerald-500/10 blur-[100px] transition-colors duration-700 pointer-events-none"></div>
        
        <!-- Imagen que NUNCA se deforma ni se corta -->
        <img 
          id="modal-main-img" 
          src="" 
          alt="Producto" 
          class="relative z-10 max-w-full max-h-full w-auto h-auto object-contain transition-opacity duration-300 drop-shadow-[0_15px_30px_rgba(0,0,0,0.8)]" 
        />

        <!-- Contador de Galería -->
        <div id="modal-gallery-counter" class="hidden absolute top-4 left-4 z-30 bg-black/70 backdrop-blur-md px-3 py-1 rounded-full text-[11px] font-mono text-zinc-300 border border-white/10 select-none shadow-md">
          <span id="modal-counter-current">1</span> / <span id="modal-counter-total">1</span>
        </div>

        <!-- Flechas de Navegación -->
        <div id="modal-nav-arrows" class="hidden absolute inset-x-3 top-1/2 -translate-y-1/2 z-30 justify-between pointer-events-none">
          <button 
            id="modal-prev-img" 
            class="pointer-events-auto w-9 h-9 sm:w-10 sm:h-10 rounded-full bg-black/60 backdrop-blur-md border border-white/15 text-white flex items-center justify-center hover:bg-white hover:text-black transition-all shadow-xl active:scale-95" 
            aria-label="Imagen anterior">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
          </button>
          <button 
            id="modal-next-img" 
            class="pointer-events-auto w-9 h-9 sm:w-10 sm:h-10 rounded-full bg-black/60 backdrop-blur-md border border-white/15 text-white flex items-center justify-center hover:bg-white hover:text-black transition-all shadow-xl active:scale-95" 
            aria-label="Siguiente imagen">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
          </button>
        </div>
      </div>

      <!-- Miniaturas en base (Horizontal scroll sin tapar contenido) -->
      <div id="modal-thumbnails-container" class="hidden flex-row gap-2.5 px-3 py-2 sm:px-4 sm:py-3 bg-[#08080a]/90 backdrop-blur-md absolute bottom-0 w-full border-t border-white/5 overflow-x-auto no-scrollbar items-center z-20">
        <!-- Renderizado dinámico vía JS -->
      </div>
    </div>

    <!-- COLUMNA 2: DETALLES, INFORMACIÓN Y COMPRA (Scroll fluido) -->
    <div id="modal-right-column" class="w-full flex-1 lg:w-[54%] h-full overflow-y-auto no-scrollbar relative bg-[#09090b] scroll-smooth">
      <div class="p-5 sm:p-7 lg:p-10 flex flex-col gap-6 sm:gap-8 pb-10 sm:pb-12">
        
        <!-- Cabecera: Categoría + Nombre + Descripción -->
        <div>
          <div class="flex items-center gap-2.5 mb-2.5">
            <span class="w-5 h-[1.5px] bg-emerald-500 block"></span>
            <p id="modal-category" class="text-[11px] text-emerald-400 uppercase tracking-widest font-semibold"></p>
          </div>
          <h2 id="modal-title" class="text-2xl sm:text-3xl md:text-4xl font-serif text-white leading-tight mb-3"></h2>
          <p id="modal-desc" class="text-zinc-400 text-xs sm:text-sm leading-relaxed font-light"></p>
        </div>

        <!-- Ficha Técnica: 3 Columnas que nunca se desbordan -->
        <div class="grid grid-cols-3 gap-2.5 sm:gap-3.5">
          <div class="bg-zinc-900/60 border border-white/5 rounded-2xl p-3 sm:p-4 flex flex-col justify-center items-start shadow-inner">
            <span class="text-[9.5px] sm:text-xs text-zinc-400 uppercase tracking-wider mb-1 font-medium flex items-center gap-1">
              <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-emerald-400"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path><polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline><line x1="12" y1="22.08" x2="12" y2="12"></line></svg>
              Piezas
            </span>
            <span id="modal-pieces" class="text-white font-serif text-lg sm:text-2xl truncate w-full"></span>
          </div>
          <div class="bg-zinc-900/60 border border-white/5 rounded-2xl p-3 sm:p-4 flex flex-col justify-center items-start shadow-inner">
            <span class="text-[9.5px] sm:text-xs text-zinc-400 uppercase tracking-wider mb-1 font-medium flex items-center gap-1">
              <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-emerald-400"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
              Tiempo
            </span>
            <span id="modal-time" class="text-white font-serif text-lg sm:text-2xl truncate w-full"></span>
          </div>
          <div class="bg-zinc-900/60 border border-white/5 rounded-2xl p-3 sm:p-4 flex flex-col justify-center items-start shadow-inner">
            <span class="text-[9.5px] sm:text-xs text-zinc-400 uppercase tracking-wider mb-1 font-medium flex items-center gap-1">
              <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-emerald-400"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
              Nivel
            </span>
            <span id="modal-difficulty" class="text-emerald-400 font-serif text-base sm:text-xl truncate w-full"></span>
          </div>
        </div>

        <!-- Módulos y desglose de Colores -->
        <div id="modal-colors-section" class="flex flex-col gap-3">
          <div class="flex justify-between items-end">
            <h3 class="text-xs sm:text-sm font-medium tracking-wide text-zinc-300">Composición de Módulos</h3>
            <span id="modal-total-colors" class="text-[11px] text-zinc-500 font-mono"></span>
          </div>
          
          <!-- Barra Proporcional -->
          <div id="modal-colors-bar" class="w-full h-2 rounded-full overflow-hidden flex bg-zinc-900 border border-white/5">
             <!-- Llenado dinámico vía JS -->
          </div>

          <!-- Píldoras de colores -->
          <div id="modal-colors-grid" class="flex flex-wrap gap-2 mt-1">
            <!-- Llenado dinámico vía JS -->
          </div>
        </div>

        <hr class="border-white/5 my-1" />

        <!-- Formato y Acción de Compra -->
        <div class="flex flex-col gap-4 sm:gap-5">
          <div class="flex items-end justify-between">
            <h3 class="text-base sm:text-lg font-serif text-white">Selecciona Formato</h3>
            <p id="modal-display-price" class="text-2xl sm:text-3xl font-serif text-white transition-opacity duration-200">$0</p>
          </div>
          
          <div class="flex flex-col gap-2.5">
            <!-- Opción Terminada -->
            <label class="relative flex items-center p-3.5 sm:p-4.5 border border-white/10 bg-zinc-900/30 rounded-2xl cursor-pointer hover:border-emerald-500/40 transition-all duration-200 has-[:checked]:border-emerald-500 has-[:checked]:bg-zinc-800/60 group">
              <input type="radio" name="modal-variant" value="Terminada" id="modal-radio-base" class="peer sr-only" checked />
              <div class="flex-1 flex justify-between items-center text-xs sm:text-sm text-zinc-400 peer-checked:text-white">
                <div class="flex items-center gap-3">
                  <div class="w-4 h-4 border border-zinc-500 rounded-full group-has-[:checked]:border-emerald-500 group-has-[:checked]:border-4 transition-all flex-shrink-0"></div>
                  <span class="font-medium tracking-wide">Escultura Terminada</span>
                </div>
                <span id="modal-price-base-label" class="font-serif text-base sm:text-lg"></span>
              </div>
            </label>
            
            <!-- Opción DIY -->
            <label class="relative flex items-center p-3.5 sm:p-4.5 border border-white/10 bg-zinc-900/30 rounded-2xl cursor-pointer hover:border-emerald-500/40 transition-all duration-200 has-[:checked]:border-emerald-500 has-[:checked]:bg-zinc-800/60 group">
              <input type="radio" name="modal-variant" value="DIY" id="modal-radio-diy" class="peer sr-only" />
              <div class="flex-1 flex justify-between items-center text-xs sm:text-sm text-zinc-400 peer-checked:text-white">
                <div class="flex items-center gap-3">
                  <div class="w-4 h-4 border border-zinc-500 rounded-full group-has-[:checked]:border-emerald-500 group-has-[:checked]:border-4 transition-all flex-shrink-0"></div>
                  <span class="font-medium tracking-wide">Kit DIY (Ármalo tú)</span>
                </div>
                <span id="modal-price-diy-label" class="font-serif text-base sm:text-lg text-emerald-400"></span>
              </div>
            </label>
          </div>

          <button id="modal-add-cart" class="w-full bg-white hover:bg-zinc-200 text-black font-semibold py-3.5 sm:py-4 rounded-xl transition-all duration-200 flex items-center justify-center gap-2 shadow-[0_0_20px_rgba(255,255,255,0.1)] active:scale-[0.98] text-sm sm:text-base mt-1">
            <span class="relative z-10 flex items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path><line x1="3" y1="6" x2="21" y2="6"></line><path d="M16 10a4 4 0 0 1-8 0"></path></svg>
              Añadir al carrito
            </span>
          </button>
        </div>

      </div>
    </div>

  </div>
</div>