---
// src/components/sections/KitsSection.astro
// Sección Educativa: Explicación de la técnica Origami 3D

interface Props {
  // Mantenemos la prop por si index.astro la envía, pero la ignoramos
  // para NO duplicar productos ni lógica del catálogo en esta sección.
  productos?: any[]; 
}
---

<section id="diy" class="py-24 lg:py-32 px-6 max-w-[90rem] mx-auto border-t border-zinc-800/30 relative">
  
  <!-- Encabezado de la Sección -->
  <div class="text-center max-w-3xl mx-auto mb-16 lg:mb-24">
    <div class="flex items-center justify-center gap-3 mb-4">
      <span class="w-8 h-[1px] bg-emerald-500 block"></span>
      <p class="text-xs text-emerald-400 uppercase tracking-widest font-medium">Kits DIY · Aprende la técnica</p>
      <span class="w-8 h-[1px] bg-emerald-500 block"></span>
    </div>
    <h2 class="text-4xl md:text-5xl lg:text-6xl font-serif text-white mb-6 leading-tight">
      El arte de construir <br/> <span class="text-transparent bg-clip-text bg-gradient-to-r from-zinc-300 to-zinc-600">pieza por pieza</span>
    </h2>
    <p class="text-zinc-400 text-base md:text-lg leading-relaxed font-light">
      Nuestras figuras no nacen de moldes. Se esculpen ensamblando miles de pequeños módulos de papel doblados a mano. Descubre cómo una simple hoja se convierte en una obra de arte.
    </p>
  </div>

  <!-- Contenedor Principal: Interfaz Sticky (Scroll Narrativo) -->
  <div class="flex flex-col lg:flex-row gap-10 lg:gap-16 relative items-start">
    
    <!-- COLUMNA IZQUIERDA: Visor Sticky (Visualización 3D / SVG) -->
    <div class="w-full lg:w-1/2 sticky top-24 lg:top-32 h-[45vh] lg:h-[600px] flex-shrink-0 bg-zinc-900/40 rounded-[2.5rem] border border-zinc-800/80 shadow-[0_0_50px_rgba(0,0,0,0.5)] overflow-hidden z-20 flex items-center justify-center backdrop-blur-sm">
      
      <!-- Fondo Glow Dinámico -->
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,rgba(16,185,129,0.15)_0%,transparent_60%)] animate-pulse-slow pointer-events-none"></div>

      <!-- Definición de la Ficha SVG (Reutilizable para máxima eficiencia) -->
      <svg class="hidden">
        <defs>
          <filter id="glow-shadow" x="-20%" y="-20%" width="140%" height="140%">
            <feDropShadow dx="0" dy="10" stdDeviation="8" flood-color="#000000" flood-opacity="0.8"/>
          </filter>
          <g id="origami-module">
            <!-- Cara Izquierda (Luz) -->
            <path d="M 0 -45 L -35 45 L 0 20 Z" fill="#10b981" />
            <!-- Cara Derecha (Sombra) -->
            <path d="M 0 -45 L 0 20 L 35 45 Z" fill="#047857" />
            <!-- Bolsillo Izquierdo (Ilusión de profundidad) -->
            <path d="M -35 45 L 0 20 L -15 55 Z" fill="#064e3b" opacity="0.6" />
            <!-- Bolsillo Derecho (Ilusión de profundidad) -->
            <path d="M 35 45 L 0 20 L 15 55 Z" fill="#064e3b" opacity="0.6" />
            <!-- Línea central para mayor contraste 3D -->
            <line x1="0" y1="-45" x2="0" y2="20" stroke="#059669" stroke-width="1.5" />
          </g>
        </defs>
      </svg>

      <!-- ESTADO 1: La Hoja -->
      <div id="visual-0" class="kit-visual absolute inset-0 flex items-center justify-center transition-all duration-700 ease-[cubic-bezier(0.4,0,0.2,1)] opacity-100 scale-100">
        <svg viewBox="0 0 200 200" class="w-48 h-48 lg:w-64 lg:h-64 drop-shadow-2xl transform -rotate-12">
          <rect x="50" y="20" width="100" height="160" rx="4" fill="#e4e4e7" />
          <!-- Líneas de doblez -->
          <line x1="50" y1="100" x2="150" y2="100" stroke="#a1a1aa" stroke-width="2" stroke-dasharray="5,5" />
          <line x1="100" y1="20" x2="100" y2="180" stroke="#a1a1aa" stroke-width="2" stroke-dasharray="5,5" />
          <line x1="50" y1="20" x2="150" y2="180" stroke="#a1a1aa" stroke-width="1.5" stroke-dasharray="3,3" />
        </svg>
      </div>

      <!-- ESTADO 2: El Módulo (Doblado) -->
      <div id="visual-1" class="kit-visual absolute inset-0 flex items-center justify-center transition-all duration-700 ease-[cubic-bezier(0.4,0,0.2,1)] opacity-0 scale-90 translate-y-8">
        <svg viewBox="-60 -60 120 120" class="w-48 h-48 lg:w-64 lg:h-64 filter drop-shadow-[0_15px_25px_rgba(16,185,129,0.3)]">
          <use href="#origami-module" filter="url(#glow-shadow)" class="animate-[float_4s_ease-in-out_infinite]" />
        </svg>
      </div>

      <!-- ESTADO 3: La Conexión -->
      <div id="visual-2" class="kit-visual absolute inset-0 flex items-center justify-center transition-all duration-700 ease-[cubic-bezier(0.4,0,0.2,1)] opacity-0 scale-90 translate-y-8">
        <svg viewBox="-80 -80 160 160" class="w-56 h-56 lg:w-72 lg:h-72">
          <!-- Módulos Base -->
          <use href="#origami-module" x="-20" y="30" filter="url(#glow-shadow)" />
          <use href="#origami-module" x="20" y="30" filter="url(#glow-shadow)" />
          <!-- Módulo Conector (Encima) -->
          <use href="#origami-module" x="0" y="-15" filter="url(#glow-shadow)" class="animate-[float_3s_ease-in-out_infinite]" />
          
          <!-- Flechas indicativas -->
          <path d="M -15 0 L -10 20" stroke="#34d399" stroke-width="2" stroke-linecap="round" stroke-dasharray="4,4" class="opacity-70" />
          <path d="M 15 0 L 10 20" stroke="#34d399" stroke-width="2" stroke-linecap="round" stroke-dasharray="4,4" class="opacity-70" />
        </svg>
      </div>

      <!-- ESTADO 4: El Ensamblaje (Estructura) -->
      <div id="visual-3" class="kit-visual absolute inset-0 flex items-center justify-center transition-all duration-700 ease-[cubic-bezier(0.4,0,0.2,1)] opacity-0 scale-90 translate-y-8">
        <svg viewBox="-100 -100 200 200" class="w-64 h-64 lg:w-[22rem] lg:h-[22rem]">
          <!-- Anillo de piezas simulado con SVGs apilados (Efecto Muro) -->
          <!-- Fila 1 (Atrás) -->
          <use href="#origami-module" x="-40" y="50" filter="url(#glow-shadow)" />
          <use href="#origami-module" x="0" y="50" filter="url(#glow-shadow)" />
          <use href="#origami-module" x="40" y="50" filter="url(#glow-shadow)" />
          <!-- Fila 2 (Medio) -->
          <use href="#origami-module" x="-20" y="10" filter="url(#glow-shadow)" />
          <use href="#origami-module" x="20" y="10" filter="url(#glow-shadow)" />
          <!-- Fila 3 (Frente) -->
          <use href="#origami-module" x="0" y="-30" filter="url(#glow-shadow)" />
        </svg>
      </div>

    </div>

    <!-- COLUMNA DERECHA: Pasos de Texto -->
    <div class="w-full lg:w-1/2 flex flex-col pt-10 pb-20 lg:py-32 relative z-10 space-y-[40vh] lg:space-y-[60vh]" id="kit-steps-container">
      
      <!-- Paso 1 -->
      <div class="kit-step flex flex-col relative transition-opacity duration-500 opacity-100 min-h-[30vh] justify-center" data-step="0">
        <div class="absolute -left-6 lg:-left-12 top-0 bottom-0 w-[2px] bg-zinc-800">
          <div class="step-indicator w-1.5 h-12 bg-emerald-500 rounded-full absolute top-0 -left-[2px] transition-all duration-500"></div>
        </div>
        <div class="flex items-end gap-4 mb-4">
          <span class="text-5xl lg:text-7xl font-serif text-zinc-800 leading-none">01</span>
          <h3 class="text-3xl lg:text-4xl font-serif text-white pb-1">Preparación</h3>
        </div>
        <p class="text-zinc-400 text-lg leading-relaxed font-light max-w-md">
          Toda obra maestra requiere una base perfecta. El proceso inicia cortando rectángulos precisos de papel de alta densidad. Las proporciones matemáticas exactas son la clave para garantizar la resistencia estructural.
        </p>
      </div>

      <!-- Paso 2 -->
      <div class="kit-step flex flex-col relative transition-opacity duration-500 opacity-30 min-h-[30vh] justify-center" data-step="1">
        <div class="absolute -left-6 lg:-left-12 top-0 bottom-0 w-[2px] bg-zinc-800">
          <div class="step-indicator w-1.5 h-12 bg-zinc-700 rounded-full absolute top-0 -left-[2px] transition-all duration-500"></div>
        </div>
        <div class="flex items-end gap-4 mb-4">
          <span class="text-5xl lg:text-7xl font-serif text-zinc-800 leading-none">02</span>
          <h3 class="text-3xl lg:text-4xl font-serif text-white pb-1">El Módulo</h3>
        </div>
        <p class="text-zinc-400 text-lg leading-relaxed font-light max-w-md">
          A través de dobleces tradicionales, la hoja de papel se transforma en la unidad fundamental del Origami 3D: el módulo. Una pieza triangular que cuenta con dos puntas inferiores y dos bolsillos interiores.
        </p>
      </div>

      <!-- Paso 3 -->
      <div class="kit-step flex flex-col relative transition-opacity duration-500 opacity-30 min-h-[30vh] justify-center" data-step="2">
        <div class="absolute -left-6 lg:-left-12 top-0 bottom-0 w-[2px] bg-zinc-800">
          <div class="step-indicator w-1.5 h-12 bg-zinc-700 rounded-full absolute top-0 -left-[2px] transition-all duration-500"></div>
        </div>
        <div class="flex items-end gap-4 mb-4">
          <span class="text-5xl lg:text-7xl font-serif text-zinc-800 leading-none">03</span>
          <h3 class="text-3xl lg:text-4xl font-serif text-white pb-1">La Conexión</h3>
        </div>
        <p class="text-zinc-400 text-lg leading-relaxed font-light max-w-md">
          El secreto de esta técnica radica en la fricción pura. No utilizamos pegamento. Las puntas de un módulo se insertan con firmeza en los bolsillos de otros, creando un vínculo estructural sorprendentemente resistente.
        </p>
      </div>

      <!-- Paso 4 -->
      <div class="kit-step flex flex-col relative transition-opacity duration-500 opacity-30 min-h-[30vh] justify-center" data-step="3">
        <div class="absolute -left-6 lg:-left-12 top-0 bottom-0 w-[2px] bg-zinc-800">
          <div class="step-indicator w-1.5 h-12 bg-zinc-700 rounded-full absolute top-0 -left-[2px] transition-all duration-500"></div>
        </div>
        <div class="flex items-end gap-4 mb-4">
          <span class="text-5xl lg:text-7xl font-serif text-zinc-800 leading-none">04</span>
          <h3 class="text-3xl lg:text-4xl font-serif text-white pb-1">El Ensamblaje</h3>
        </div>
        <p class="text-zinc-400 text-lg leading-relaxed font-light max-w-md">
          Repitiendo esta conexión cientos o miles de veces, generamos anillos que van creciendo y cerrándose. Esculpimos el volumen en el espacio, permitiendo que simples trozos de papel den vida a figuras espectaculares.
        </p>
      </div>

    </div>
  </div>

  <!-- Call to Action Final (Conecta al Catálogo suavemente) -->
  <div class="mt-20 lg:mt-32 max-w-2xl mx-auto text-center bg-zinc-900/30 border border-zinc-800 p-10 lg:p-14 rounded-[3rem] shadow-inner relative overflow-hidden group">
    <div class="absolute inset-0 bg-gradient-to-t from-emerald-500/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-700 pointer-events-none"></div>
    <h3 class="text-3xl font-serif text-white mb-4">¿Listo para construir?</h3>
    <p class="text-zinc-400 mb-8 max-w-md mx-auto text-sm lg:text-base leading-relaxed">
      Nuestros Kits DIY incluyen todas las piezas listas para ensamblar, manuales detallados y acceso a tutoriales. Construye tu propia escultura hoy.
    </p>
    <a href="#catalogo" class="nav-link inline-flex items-center gap-3 bg-white text-black hover:bg-zinc-200 px-8 py-4 rounded-full font-semibold text-sm transition-all duration-300 shadow-[0_0_20px_rgba(255,255,255,0.1)] hover:shadow-[0_0_30px_rgba(255,255,255,0.2)] hover:-translate-y-1">
      Explorar el Catálogo
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
    </a>
  </div>

</section>

<style>
  /* Animación de flotación suave para los SVGs */
  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-10px); }
  }
</style>

<script>
  // Inicialización de la interactividad al hacer scroll (ScrollTrigger GSAP)
  document.addEventListener('DOMContentLoaded', () => {
    // Verificamos si GSAP está disponible en el proyecto
    if (typeof (window as any).gsap === 'undefined' || typeof (window as any).ScrollTrigger === 'undefined') {
      return; 
    }

    const gsap = (window as any).gsap;
    const ScrollTrigger = (window as any).ScrollTrigger;

    const steps = document.querySelectorAll('.kit-step');
    const visuals = document.querySelectorAll('.kit-visual');

    // Función que actualiza el estado de la vista
    function activateVisual(index: number) {
      
      // Actualizar Transiciones de SVG en el Sticky Box
      visuals.forEach((v, i) => {
        if (i === index) {
          // Mostrar Visual Activo
          v.classList.remove('opacity-0', 'scale-90', 'translate-y-8');
          v.classList.add('opacity-100', 'scale-100', 'translate-y-0');
        } else {
          // Ocultar los demás
          v.classList.remove('opacity-100', 'scale-100', 'translate-y-0');
          v.classList.add('opacity-0', 'scale-90', 'translate-y-8');
        }
      });

      // Actualizar Transparencias y Barras Indicadoras del texto
      steps.forEach((step, i) => {
        const indicator = step.querySelector('.step-indicator');
        if (i === index) {
          step.classList.remove('opacity-30');
          step.classList.add('opacity-100');
          if(indicator) {
            indicator.classList.remove('bg-zinc-700');
            indicator.classList.add('bg-emerald-500');
          }
        } else {
          step.classList.add('opacity-30');
          step.classList.remove('opacity-100');
          if(indicator) {
            indicator.classList.add('bg-zinc-700');
            indicator.classList.remove('bg-emerald-500');
          }
        }
      });
    }

    // Configuración de Triggers de scroll
    steps.forEach((step, index) => {
      ScrollTrigger.create({
        trigger: step,
        start: "top 60%",     // Cuando el borde superior del texto toque el 60% de la pantalla
        end: "bottom 40%",    // Cuando el borde inferior toque el 40% de la pantalla
        onEnter: () => activateVisual(index),
        onEnterBack: () => activateVisual(index),
      });
    });

    // Activar el primer paso por defecto al cargar
    activateVisual(0);
  });
</script>