
<section class="snap-start py-12 md:py-16 px-6 max-w-6xl mx-auto w-full relative z-10">
    <div class="gsap-promo-box relative overflow-hidden rounded-3xl bg-[#080808] border border-zinc-800 shadow-2xl">
        
        <!-- Elementos decorativos (Glassmorphism) -->
        <div class="absolute inset-0 w-full h-full pointer-events-none">
            <div class="absolute -top-32 -left-32 w-80 h-80 bg-emerald-700/10 rounded-full blur-[100px]"></div>
            <div class="absolute top-1/2 right-10 w-40 h-40 bg-white/5 rounded-full blur-[60px] transform -translate-y-1/2"></div>
        </div>

        <div class="relative z-10 flex flex-col md:flex-row items-center justify-between p-8 md:p-10 gap-8">
            <div class="flex-1 text-center md:text-left">
                <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-zinc-900/80 backdrop-blur border border-zinc-700/50 text-emerald-400 text-[10px] uppercase tracking-widest font-semibold mb-3 gsap-promo-elem">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                    Tu próximo proyecto
                </div>
                <h2 class="text-3xl md:text-4xl font-serif text-white mb-2 gsap-promo-elem">Construye el tuyo en casa</h2>
                <p class="text-zinc-400 text-sm max-w-md mx-auto md:mx-0 leading-relaxed gsap-promo-elem">
                    Recibe las piezas pre-dobladas y todo lo necesario para armar tu figura. Una experiencia sumamente satisfactoria.
                </p>
            </div>
            
            <div class="flex flex-col sm:flex-row items-center gap-4 flex-shrink-0 w-full md:w-auto gsap-promo-elem">
                <button id="promo-btn-diy" class="w-full sm:w-auto px-8 py-3 bg-white text-black hover:bg-zinc-200 hover:-translate-y-0.5 rounded-xl font-semibold transition-all shadow-[0_0_20px_rgba(255,255,255,0.05)] text-sm flex items-center justify-center gap-2">
                    Explorar Kits DIY
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
                </button>
            </div>
        </div>
    </div>
</section>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        if(typeof (window as any).gsap === 'undefined') return;
        const gsap = (window as any).gsap;

        // GSAP Promo Animation
        gsap.timeline({ scrollTrigger: { trigger: ".gsap-promo-box", start: "top 90%", toggleActions: "play none none reverse" } })
            .fromTo(".gsap-promo-box", { scale: 0.98, opacity: 0, y: 30 }, { scale: 1, opacity: 1, y:0, duration: 0.8, ease: "power3.out" })
            .fromTo(".gsap-promo-elem", { y: 15, opacity: 0 }, { y: 0, opacity: 1, duration: 0.5, stagger: 0.1, ease: "power3.out" }, "-=0.4");

        // Emitir Evento en lugar de código directo
        document.getElementById('promo-btn-diy')?.addEventListener('click', () => {
            document.dispatchEvent(new CustomEvent('catalog:category', { detail: { category: 'DIY' } }));
            document.getElementById('catalogo')?.scrollIntoView({behavior: 'smooth'});
        });
    });
</script>