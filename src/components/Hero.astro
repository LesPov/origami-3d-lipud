---
// src/components/Hero.astro
interface Props {
  productos: any[];
}

const { productos } = Astro.props;

// Extraemos hasta las 3 primeras figuras de Sanity para el carrusel 3D
const carruselItems = (productos && productos.length > 0 ? productos.slice(0, 3) : []).map(prod => ({
  nombre: prod.nombre,
  img: prod.imagenes?.[0] || 'https://images.unsplash.com/photo-1578632767115-351597cf2477?w=800&auto=format&fit=crop&q=80',
  precio: `$${(prod.precioBase || 0).toLocaleString('es-CO')}`
}));
---

<section class="min-h-screen pt-32 pb-20 px-6 max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-2 items-center gap-12 lg:gap-16 relative z-10 overflow-hidden">
	
	<!-- 1. COLUMNA DE TEXTO -->
	<div class="flex flex-col items-start text-left hero-content relative z-20 w-full">
		<div class="overflow-hidden mb-6 gsap-hero-badge">
			<span class="px-3.5 py-1.5 bg-white/5 backdrop-blur-md border border-white/10 text-zinc-300 rounded-full text-xs font-medium inline-flex items-center gap-2 transform translate-y-full shadow-lg">
				<span class="w-1.5 h-1.5 bg-emerald-500 rounded-full animate-pulse shadow-[0_0_8px_rgba(16,185,129,0.8)]"></span> Arte Premium en Papel
			</span>
		</div>
		
		<h1 class="text-5xl lg:text-6xl xl:text-7xl font-serif text-white mb-6 leading-[1.1] tracking-tight">
			<div class="overflow-hidden"><div class="gsap-hero-title transform translate-y-[120%]">Colección Exclusiva:</div></div>
			<div class="overflow-hidden"><div class="gsap-hero-title transform translate-y-[120%]"><span class="text-transparent bg-clip-text bg-gradient-to-r from-zinc-100 to-zinc-500">Héroes en</span></div></div>
			<div class="overflow-hidden"><div class="gsap-hero-title transform translate-y-[120%]">Origami 3D</div></div>
		</h1>
		
		<p class="text-lg text-zinc-400 max-w-md mb-10 leading-relaxed gsap-hero-desc opacity-0 font-light">
			Esculturas épicas ensambladas a mano con miles de módulos de papel. Diseñadas meticulosamente para destacar en tu espacio.
		</p>
		
		<div class="flex flex-wrap gap-4 gsap-hero-btns opacity-0 translate-y-4">
			<button id="btn-catalogo" class="bg-white hover:bg-zinc-200 text-black px-8 py-3.5 rounded-full font-semibold text-sm transition-colors shadow-[0_0_20px_rgba(255,255,255,0.15)] hover:shadow-[0_0_30px_rgba(255,255,255,0.3)]">
				Ver Catálogo
			</button>
			<button id="btn-diy" class="bg-transparent hover:bg-white/5 border border-white/20 text-white px-8 py-3.5 rounded-full font-semibold text-sm transition-colors backdrop-blur-sm">
				Kits DIY
			</button>
		</div>
		
		<div class="flex gap-8 lg:gap-12 mt-16 border-t border-white/10 pt-8 w-full gsap-hero-stats opacity-0">
			<div><p class="text-3xl font-serif text-white">10+</p><p class="text-sm text-zinc-500 font-medium">Modelos únicos</p></div>
			<div><p class="text-3xl font-serif text-white">100%</p><p class="text-sm text-zinc-500 font-medium">Hecho a mano</p></div>
			<div><p class="text-3xl font-serif text-white">Top</p><p class="text-sm text-zinc-500 font-medium">Calidad premium</p></div>
		</div>
	</div>
	
	<!-- 2. COLUMNA CARRUSEL 3D -->
	<div class="gsap-hero-carousel opacity-0 scale-95 relative h-[420px] sm:h-[550px] lg:h-[650px] w-full flex items-center justify-center mt-8 lg:mt-0" style="perspective: 1400px;">
		<div id="carousel-3d-container" class="w-full h-full relative flex items-center justify-center" style="transform-style: preserve-3d;">
			{carruselItems.map((prod, index) => (
				<div class="carousel-panel absolute w-[250px] sm:w-[320px] lg:w-[360px] aspect-[3/4] cursor-pointer group" style="transform-style: preserve-3d;">
					
					<!-- FONDO E IMAGEN -->
					<div class="panel-bg absolute inset-0 rounded-[2rem] overflow-hidden border border-white/10 bg-zinc-900 shadow-[0_20px_50px_-10px_rgba(0,0,0,0.8)] transition-all duration-700">
						<div class="panel-overlay absolute inset-0 bg-gradient-to-t from-black/90 via-black/20 to-transparent z-10 transition-opacity duration-700 pointer-events-none opacity-80 group-hover:opacity-100"></div>
						<img src={prod.img} class="w-full h-full object-cover relative z-0 scale-105 group-hover:scale-100 transition-transform duration-700" alt={prod.nombre} loading={index === 0 ? "eager" : "lazy"} />
					</div>
					
					<!-- ETIQUETA DE PRECIO -->
					<div class="price-flag absolute top-6 sm:top-8 -right-3 sm:-right-5 z-30 opacity-0 transform translate-x-8 transition-all duration-700 pointer-events-none">
						<div class="bg-emerald-500 text-black px-4 py-2 sm:px-5 sm:py-2.5 rounded-xl sm:rounded-2xl shadow-[0_15px_35px_rgba(16,185,129,0.5)] border border-emerald-400 flex items-center justify-center relative">
							<span class="font-sans font-bold text-base sm:text-lg tracking-wide drop-shadow-sm">{prod.precio}</span>
							<div class="absolute -bottom-2 -left-1 w-full h-full bg-emerald-600/50 rounded-xl sm:rounded-2xl -z-10 blur-sm"></div>
						</div>
					</div>

					<!-- NOMBRE DE LA FIGURA -->
					<div class="name-pill absolute bottom-6 sm:bottom-8 left-1/2 transform -translate-x-1/2 z-20 opacity-0 translate-y-8 transition-all duration-700 pointer-events-none w-[75%] sm:w-[80%]">
						<div class="bg-black/30 backdrop-blur-3xl border border-white/15 py-3 sm:py-3.5 px-4 sm:px-6 rounded-2xl flex justify-center items-center shadow-[0_10px_40px_rgba(0,0,0,0.8)]">
							<h3 class="text-white font-serif text-lg sm:text-xl tracking-wide text-center w-full drop-shadow-md truncate">
								{prod.nombre}
							</h3>
						</div>
					</div>

				</div>
			))}
		</div>
	</div>
</section>

<style>
	.carousel-panel.active-panel .panel-overlay {
		opacity: 0.05 !important;
	}
	.carousel-panel.active-panel .price-flag {
		opacity: 1 !important;
		transform: translateX(0) !important;
	}
	.carousel-panel.active-panel .name-pill {
		opacity: 1 !important;
		transform: translateY(0) translateX(-50%) !important;
	}
	.carousel-panel.active-panel .panel-bg {
		border-color: rgba(255, 255, 255, 0.3) !important;
		box-shadow: 0 40px 80px -10px rgba(0, 0, 0, 0.9), 0 0 40px -10px rgba(16, 185, 129, 0.3) !important;
	}
</style>

<script>
	import gsap from "gsap";
	
	const btnCatalogo = document.getElementById('btn-catalogo');
	if (btnCatalogo) {
		btnCatalogo.addEventListener('click', () => {
			const catalogo = document.getElementById('catalogo');
			if (catalogo) catalogo.scrollIntoView({ behavior: 'smooth' });
		});
	}

	const btnDiy = document.getElementById('btn-diy');
	if (btnDiy) {
		btnDiy.addEventListener('click', () => {
			const diyLink = document.querySelector('.nav-link[href="#diy"]');
			if (diyLink) (diyLink as HTMLElement).click();
		});
	}

	window.addEventListener('DOMContentLoaded', () => {
		if (typeof gsap === 'undefined') return;

		const appleEase = "power3.out";

		const heroTl = gsap.timeline();
		heroTl.to(".gsap-hero-badge span", { y: 0, duration: 1, ease: appleEase })
			  .to(".gsap-hero-title", { y: 0, duration: 1.2, stagger: 0.1, ease: "power4.out" }, "-=0.7")
			  .to(".gsap-hero-desc", { opacity: 1, y: 0, duration: 1, ease: appleEase }, "-=0.8")
			  .to(".gsap-hero-btns, .gsap-hero-stats", { opacity: 1, y: 0, duration: 1, stagger: 0.2, ease: appleEase }, "-=0.8")
			  .to(".gsap-hero-carousel", { opacity: 1, scale: 1, duration: 1.5, ease: appleEase }, "-=1.2");

		const panels = gsap.utils.toArray<HTMLElement>('.carousel-panel');
		let currentIndex = 0;
		const total = panels.length;
		
		if(total === 0) return;

		function updateCarousel() {
			const width = window.innerWidth;
			const isMobile = width < 768;
			const isTablet = width >= 768 && width < 1024;
			
			panels.forEach((panel, i) => {
				let diff = i - currentIndex;
				if (diff < -1) diff += 3;
				if (diff > 1) diff -= 3;

				let x = 0, z = 0, rotateY = 0, zIndex = 10, scale = 1;

				if (diff === 0) {
					x = 0; 
					z = 100; 
					rotateY = 0; 
					zIndex = 30; 
					scale = 1;
					panel.classList.add('active-panel');
				} else if (diff === 1 || diff === -1) {
					const offset = isMobile ? 120 : (isTablet ? 180 : 250); 
					x = diff * offset;
					z = -150; 
					rotateY = diff * -25; 
					zIndex = 20;
					scale = 0.85;
					panel.classList.remove('active-panel');
				}

				gsap.to(panel, {
					x: x, 
					z: z,
					rotationY: rotateY,
					scale: scale,
					zIndex: zIndex,
					duration: 1.2, 
					ease: "power3.out",
					overwrite: "auto"
				});
			});
		}

		updateCarousel();
		window.addEventListener('resize', updateCarousel);

		panels.forEach((panel, i) => {
			panel.addEventListener('click', () => {
				if(currentIndex === i) return;
				currentIndex = i;
				updateCarousel();
				resetAutoplay();
			});
		});

		let autoPlay = setInterval(nextSlide, 4500);

		function nextSlide() {
			currentIndex = (currentIndex + 1) % total;
			updateCarousel();
		}

		function resetAutoplay() {
			clearInterval(autoPlay);
			autoPlay = setInterval(nextSlide, 4500);
		}

		gsap.to("#carousel-3d-container", {
			y: -10,
			rotationX: 1.5,
			rotationY: -1,
			duration: 5,
			repeat: -1,
			yoyo: true,
			ease: "sine.inOut"
		});
	});
</script>