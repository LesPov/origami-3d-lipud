---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Showcase from '../components/Showcase.astro';
import Catalog from '../components/Catalog.astro'; 
import Process from '../components/sections/Process.astro';
import KitsSection from '../components/sections/KitsSection.astro';
import ProductModal from '../components/ProductModal.astro';
import { getProductos } from '../sanity/products';

// Obtenemos los productos una sola vez de forma centralizada
const productos = await getProductos();

// El producto destacado para Showcase y Proceso es el primero en prioridad
const productoDestacado = productos[0];
---

<Layout title="Origami3D Art | Figuras de Origami 3D">
	
	<!-- 1. HERO -->
	<Hero productos={productos} />

	<!-- 2. PRODUCTO DESTACADO (SHOWCASE) -->
	{productoDestacado && <Showcase producto={productoDestacado} />}

	<!-- 3. CATÁLOGO COMPLETO -->
	<Catalog productos={productos} />

	<!-- 4. SECCIÓN PROCESO ARTESANAL -->
	{productoDestacado && <Process producto={productoDestacado} />}

	<!-- 5. KITS DIY -->
	<KitsSection productos={productos} />

	<!-- 6. MODAL DE PRODUCTO -->
	<ProductModal />

</Layout>